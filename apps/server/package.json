{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@orpc/openapi": "^1.13.2",
    "@orpc/server": "^1.13.2",
    "@orpc/zod": "^1.13.2",
    "@work-holo/api": "workspace:*",
    "@work-holo/auth": "workspace:*",
    "@work-holo/db": "workspace:*",
    "@work-holo/env": "workspace:*",
    "better-auth": "^1.4.11",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "pusher": "^5.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.5",
    "tsdown": "^0.20.0-beta.1",
    "@work-holo/config": "workspace:*"
  }
}

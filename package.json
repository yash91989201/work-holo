{
  "name": "work-holo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "workers/*"
    ],
    "catalog": {}
  },
  "scripts": {
    "check": "oxlint",
    "prepare": "husky",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "auth:generate": "bunx @better-auth/cli@latest generate --config packages/auth/src/index.ts --output packages/db/src/schema/auth.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:www": "turbo -F www dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @work-holo/db db:push",
    "db:studio": "turbo -F @work-holo/db db:studio",
    "db:generate": "turbo -F @work-holo/db db:generate",
    "db:migrate": "turbo -F @work-holo/db db:migrate",
    "seed": "turbo -F seeder seed"
  },
  "dependencies": {
    "@fontsource/michroma": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.70.0",
    "turbo": "^2.9.18",
    "ultracite": "^7.8.3",
    "web-push": "^3.6.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "overrides": {
    "better-auth": "1.5.5",
    "@better-auth/core": "1.5.5",
    "@better-auth/expo": "1.5.5",
    "@better-auth/passkey": "1.5.5"
  },
  "packageManager": "bun@1.3.13"
}

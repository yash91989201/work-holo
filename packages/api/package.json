    "@orpc/zod": "^1.14.6",
    "@t3-oss/env-core": "^0.13.11",
    "@work-holo/auth": "workspace:*",
    "@work-holo/db": "workspace:*",
    "@work-holo/infrastructure": "workspace:*",
    "@work-holo/permission": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.26",

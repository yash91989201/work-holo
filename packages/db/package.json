{
  "name": "@work-holo/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "generate:types": "bun run ./scripts/generate-types.ts",
    "generate:types:watch": "bun run ./scripts/generate-types.ts --watch"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@work-holo/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "chokidar": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "drizzle-cuid2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}

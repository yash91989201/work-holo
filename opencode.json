{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tanstack": {
      "type": "local",
      "command": ["npx", "-y", "@tanstack/cli", "mcp"],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "tavily": {
      "command": ["npx", "-y", "tavily-mcp"],
      "type": "local",
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    }
  }
}
